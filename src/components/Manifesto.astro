<section id="manifesto" class="py-24 px-6 relative">
  <div class="max-w-3xl mx-auto">
    <h2 class="font-mono text-xs tracking-[0.25em] uppercase text-accent mb-10">// Manifesto</h2>

    <ul class="space-y-5 sm:space-y-6 mb-14">
      <li class="manifesto-line pl-5 sm:pl-6 border-l border-accent/30 text-2xl sm:text-3xl md:text-4xl font-light leading-tight tracking-tight text-cream">
        Build <span class="gradient-text font-medium">world-changing products</span>.
      </li>
      <li class="manifesto-line pl-5 sm:pl-6 border-l border-accent/30 text-2xl sm:text-3xl md:text-4xl font-light leading-tight tracking-tight text-cream">
        Stay obsessed with <span class="gradient-text font-medium">customers</span>.
      </li>
      <li class="manifesto-line pl-5 sm:pl-6 border-l border-accent/30 text-2xl sm:text-3xl md:text-4xl font-light leading-tight tracking-tight text-cream">
        Push <span class="gradient-text font-medium">technology</span> forward.
      </li>
      <li class="manifesto-line pl-5 sm:pl-6 border-l border-accent/30 text-2xl sm:text-3xl md:text-4xl font-light leading-tight tracking-tight text-cream">
        Assemble <span class="gradient-text font-medium">high-performing teams</span>.
      </li>
    </ul>

    <div>
      <p class="font-mono text-[0.65rem] sm:text-xs tracking-[0.25em] uppercase text-warm-dim mb-4">What drives me</p>
      <ul class="flex flex-wrap gap-2 sm:gap-2.5">
        <li><span class="inline-block font-mono text-xs tracking-wide px-3.5 py-1.5 rounded-full border border-accent/25 text-warm-gray hover:bg-accent/10 hover:border-accent/55 hover:text-accent transition-all duration-300">Hard problems</span></li>
        <li><span class="inline-block font-mono text-xs tracking-wide px-3.5 py-1.5 rounded-full border border-accent/25 text-warm-gray hover:bg-accent/10 hover:border-accent/55 hover:text-accent transition-all duration-300">Innovative tech</span></li>
        <li><span class="inline-block font-mono text-xs tracking-wide px-3.5 py-1.5 rounded-full border border-accent/25 text-warm-gray hover:bg-accent/10 hover:border-accent/55 hover:text-accent transition-all duration-300">High-performing teams</span></li>
        <li><span class="inline-block font-mono text-xs tracking-wide px-3.5 py-1.5 rounded-full border border-accent/25 text-warm-gray hover:bg-accent/10 hover:border-accent/55 hover:text-accent transition-all duration-300">Customer obsession</span></li>
        <li><span class="inline-block font-mono text-xs tracking-wide px-3.5 py-1.5 rounded-full border border-accent/25 text-warm-gray hover:bg-accent/10 hover:border-accent/55 hover:text-accent transition-all duration-300">Focus &amp; organization</span></li>
        <li><span class="inline-block font-mono text-xs tracking-wide px-3.5 py-1.5 rounded-full border border-accent/25 text-warm-gray hover:bg-accent/10 hover:border-accent/55 hover:text-accent transition-all duration-300">Candid communication</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .manifesto-line {
    opacity: 0;
    transform: translateX(-8px);
    transition: opacity 700ms ease-out, transform 700ms ease-out;
  }
  .manifesto-line.is-visible {
    opacity: 1;
    transform: translateX(0);
  }
  @media (prefers-reduced-motion: reduce) {
    .manifesto-line {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const lines = document.querySelectorAll<HTMLElement>('.manifesto-line');
  if (lines.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const idx = Array.from(lines).indexOf(el);
            setTimeout(() => el.classList.add('is-visible'), idx * 120);
            io.unobserve(el);
          }
        });
      },
      { threshold: 0.2 }
    );
    lines.forEach((l) => io.observe(l));
  } else {
    lines.forEach((l) => l.classList.add('is-visible'));
  }
</script>
